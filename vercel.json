{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/data",
      "destination": "/api/data"
    },
    {
      "source": "/neuromechfly-tris",
      "destination": "/neuromechfly-tris/index.html"
    },
    {
      "source": "/neuromechfly-tris/",
      "destination": "/neuromechfly-tris/index.html"
    },
    {
      "source": "/((?!api|neuromechfly-tris).*)",
      "destination": "/index.html"
    }
  ]
}
